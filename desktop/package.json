{
  "name": "utkristi-colabs-desktop",
  "productName": "Utkristi CoLabs",
  "version": "1.0.0",
  "description": "Desktop app for Utkristi CoLabs: real-time pair programming with a built-in code runner and a local AI model.",
  "homepage": "https://github.com/utkarsh-1912/rtm-code-editor",
  "main": "main.js",
  "author": "Utkristi.io",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "npm run bundle-web && electron-builder --publish never",
    "dist:win": "npm run bundle-web && electron-builder --win --publish never",
    "dist:mac": "npm run bundle-web && electron-builder --mac --publish never",
    "dist:linux": "npm run bundle-web && electron-builder --linux --publish never",
    "bundle-web": "node scripts/bundle-web.js",
    "installer-art": "python scripts/make-installer-art.py"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.utkristi.colabs",
    "productName": "Utkristi CoLabs",
    "asarUnpack": [
      "node_modules/pyodide/**",
      "node_modules/sql.js/dist/sql-wasm.*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "local.js",
      "runner.js",
      "sandbox.js",
      "packs.js",
      "fsAccess.js",
      "terminal.js",
      "terminal-preload.js",
      "terminal.html",
      "terminal-ui.js",
      "localUi.js",
      "splash.html",
      "build/icon.png",
      "web/**/*",
      "!node_modules/sql.js/dist/sql-asm*",
      "!node_modules/sql.js/dist/*debug*",
      "!node_modules/sql.js/dist/sql-wasm-browser*",
      "!node_modules/sql.js/dist/worker*",
      "!node_modules/sql.js/dist/*.zip",
      "!node_modules/pyodide/*.map",
      "!node_modules/pyodide/*.html"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Utkristi-CoLabs-win-x64.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Utkristi CoLabs",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "uninstallDisplayName": "Utkristi CoLabs",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "Utkristi-CoLabs-mac-universal.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "maintainer": "Utkristi.io",
      "artifactName": "Utkristi-CoLabs-linux-x64.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "utkarsh-1912",
        "repo": "rtm-code-editor",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "extract-zip": "^2.0.1",
    "fengari": "^0.1.5",
    "pyodide": "^314.0.7",
    "sql.js": "^1.15.1",
    "sucrase": "^3.35.1"
  }
}
